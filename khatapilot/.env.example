# Copy to .env — `python scripts/make_env.py` (or scripts\dev.ps1) does this and fills in random secrets.
# Never commit .env.

APP_ENV=dev

# --- LLM -------------------------------------------------------------------
# mock               deterministic rule-based agent: no key, no network (tests and CI use this)
# anthropic          Claude through the official SDK (what we record the demo with)
# openai_compatible  any OpenAI-compatible endpoint
LLM_MODE=mock
LLM_MODEL=claude-sonnet-5-5
# Thinking effort for Claude: low | medium | high | xhigh | max (medium suits multistep tool use)
LLM_EFFORT=medium
# Server-side refusal fallback on the Claude API (only used for models that support it)
LLM_FALLBACKS=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Secrets (left empty here; make_env.py generates them) -------------------
# Shared by the backend guard and the sandbox. The sandbox refuses any payment, message or
# loan application that is not signed with it.
GUARD_SIGNING_KEY=
# The web UI authenticates as the shop owner with this token (local demo only).
OWNER_TOKEN=
# Lets scripts reset and seed the sandbox. Never available to the agent.
SANDBOX_ADMIN_KEY=
# The demo owner's PIN (approving tier 3 payments, resuming after STOP). Read only by the seed and
# demo scripts; the app stores just an argon2 hash and never shows or logs it.
DEMO_OWNER_PIN=

# --- Services ---------------------------------------------------------------
SANDBOX_URL=http://127.0.0.1:8100
FRONTEND_ORIGIN=http://localhost:5173

# --- Demo -------------------------------------------------------------------
SHOP_ID=rahman-store
# The simulated "now" (Bangladesh time) so the demo shop's data is always current.
# Leave empty to use the real clock.
SIM_TIME=2026-10-12T10:00:00+06:00

# --- Fraud scoring and scheduling ---------------------------------------------
# sentinel = the trained Fraud Sentinel model (scripts/train_models.py); rules = the transparent fallback
RISK_MODEL=sentinel
# How often due scheduled payments are checked and run, in seconds (0 turns the loop off)
SCHEDULER_INTERVAL_SECONDS=60

# --- Cash forecast ----------------------------------------------------------
# The safety buffer the owner wants to keep on hand (taka), and how many days ahead to look.
FORECAST_BUFFER_TAKA=5000
FORECAST_DAYS=14

# --- Guard defaults (taka). The owner changes limits in the app, with their PIN. ---
PER_TXN_LIMIT_TAKA=10000
DAILY_LIMIT_TAKA=25000
FRAUD_MEDIUM=0.50
FRAUD_HIGH=0.85
