# Copy to .env — `python scripts/make_env.py` (or scripts\dev.ps1) does this and fills in random secrets.
# Never commit .env.

APP_ENV=dev

# --- LLM -------------------------------------------------------------------
# mock               deterministic rule-based agent: no key, no network (tests and CI use this)
# anthropic          Claude through the official SDK (what we record the demo with)
# openai_compatible  any OpenAI-compatible endpoint
LLM_MODE=mock
LLM_MODEL=claude-sonnet-5-5
# Thinking effort for Claude: low | medium | high | xhigh | max (medium suits multistep tool use)
LLM_EFFORT=medium
# Server-side refusal fallback on the Claude API (only used for models that support it)
LLM_FALLBACKS=true
# With a real model: short, plain requests the offline rules read for certain (balances, who owes,
# "sold rice ৳1,500 cash") are answered by them at no API cost; everything else goes to the model.
LLM_RULES_FIRST=true
# With a real model: if it can't be reached (no network, timeout, busy, down), the offline planner
# answers that turn, marked "offline" in the chat and the trace. A bad key still shows its error.
LLM_OFFLINE_FALLBACK=true
# AI spend per shop per calendar month, in US$ at list prices (0 = no cap). Once it is spent, the offline
# planner answers every message free until the month ends; Alerts shows the month's use. USD_TO_BDT only
# turns the spend into "about ৳..." for the owner.
LLM_MONTHLY_BUDGET_USD=2.0
USD_TO_BDT=122
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Secrets (left empty here; make_env.py generates them) -------------------
# Shared by the backend guard and the sandbox. The sandbox refuses any payment, message or
# loan application that is not signed with it.
GUARD_SIGNING_KEY=
# The web UI authenticates as the shop owner with this token (local demo only).
OWNER_TOKEN=
# Lets scripts reset and seed the sandbox. Never available to the agent.
SANDBOX_ADMIN_KEY=
# The demo owner's PIN (approving tier 3 payments, resuming after STOP). Read only by the seed and
# demo scripts; the app stores just an argon2 hash and never shows or logs it.
DEMO_OWNER_PIN=

# --- Services ---------------------------------------------------------------
SANDBOX_URL=http://127.0.0.1:8100
FRONTEND_ORIGIN=http://localhost:5173

# --- Demo -------------------------------------------------------------------
SHOP_ID=rahman-store
# The simulated "now" (Bangladesh time) so the demo shop's data is always current.
# Leave empty to use the real clock.
SIM_TIME=2026-10-12T10:00:00+06:00

# --- Fraud scoring and scheduling ---------------------------------------------
# sentinel = the trained Fraud Sentinel model (scripts/train_models.py); rules = the transparent fallback
RISK_MODEL=sentinel
# How often due scheduled payments are checked and run, in seconds (0 turns the loop off)
SCHEDULER_INTERVAL_SECONDS=60
# true: the loop runs inside the web server. false: run `python scripts/worker.py` as its own process
# (docker-compose does). A database lease lets only one process run the jobs either way.
SCHEDULER_IN_WEB=true

# --- The owner's phone: real SMS in and out ------------------------------------
# Install the open-source "SMS Gateway for Android" app (sms-gate.app), turn on Local Server, plug the
# phone in by USB and run:  adb forward tcp:8080 tcp:8080   and   adb reverse tcp:8000 tcp:8000
# Then bKash/Nagad/bank SMS the phone receives are booked through the guard (Ledger tab > Phone SMS).
PHONE_GATEWAY_URL=
PHONE_GATEWAY_USER=
PHONE_GATEWAY_PASSWORD=
# The app's Settings > Webhooks > Signing Key (new SMS arrive by themselves, signed with it)
PHONE_WEBHOOK_KEY=
PHONE_WEBHOOK_URL=http://127.0.0.1:8000/api/phone/webhook
# sender_id: an SMS from bKash's/Nagad's/the bank's own sender ID is booked even when the provider cannot
# confirm its TrxID (real personal accounts have no statement API); above PHONE_SMS_REVIEW_TAKA it waits
# for you. provider: only what the provider confirms. A money SMS from an ordinary number is never booked.
PHONE_SMS_TRUST=sender_id
PHONE_SMS_REVIEW_TAKA=20000
# true: approved reminders and your alert SMS also leave from your phone's SIM (after the guard's checks)
SMS_VIA_PHONE=false
# Your own number, and whether urgent/important alerts are texted to it (at most this many a day)
OWNER_PHONE=
OWNER_ALERT_SMS=false
OWNER_ALERT_SMS_PER_DAY=6

# --- Voice input -------------------------------------------------------------
# Offline speech-to-text: pip install -r requirements-voice.txt, then python scripts/get_voice_model.py
# (about 1.6 GB for large-v3-turbo; `small` is faster on slow laptops, less accurate for Banglish).
# Without it, the browser's own recognizer is used.
STT_ENABLED=true
STT_MODEL=large-v3-turbo

# --- The advisor -------------------------------------------------------------
# Weekly advice in Alerts (0 = Monday ... 5 = Saturday, from this hour, local time). Ask "any advice?" in chat any time.
ADVICE_WEEKLY=true
ADVICE_WEEKDAY=5
ADVICE_HOUR=9

# --- Backups and monitoring -------------------------------------------------
# python scripts/backup.py makes a checked backup of the books and the audit log in BACKUP_DIR
# (default var/backups); `drill` rehearses a restore. BACKUP_DAILY=true has the backend make one a day.
BACKUP_DAILY=false
BACKUP_KEEP=14
# /api/metrics (Prometheus text). With a token, a scraper sends "Authorization: Bearer <token>";
# without one only this machine can read it. /api/ops/errors (errors grouped by where they happen) uses the same rule.
METRICS_TOKEN=
# Logs: JSON lines on stderr and in var/logs/khatapilot.jsonl (rotated); `text` for a terminal.
# With SENTRY_DSN set and `pip install sentry-sdk`, errors also go to Sentry.
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=
# Uptime: python scripts/uptime_check.py texts OWNER_PHONE (through the phone) when the backend goes down and back up.

# --- Cash forecast ----------------------------------------------------------
# The safety buffer is sized from each shop's own books (its size and how much its cash goes up and
# down) and the owner can set their own in chat. This standard one (taka) is used until there are two
# weeks of sales to size it from. FORECAST_DAYS: how many days ahead to look.
FORECAST_BUFFER_TAKA=5000
FORECAST_DAYS=14

# --- Guard defaults (taka). The owner changes limits in the app, with their PIN. ---
PER_TXN_LIMIT_TAKA=10000
DAILY_LIMIT_TAKA=25000
FRAUD_MEDIUM=0.50
FRAUD_HIGH=0.85
